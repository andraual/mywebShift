#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCRIPT="$ROOT_DIR/scripts/bump-version.sh"

if [[ -x "$SCRIPT" ]]; then
  "$SCRIPT"
  git add "$ROOT_DIR/src/config.js"
else
  echo "Script de versão não encontrado ou sem permissão: $SCRIPT" >&2
  exit 1
fi